            friction="1.0 0.005 0.0001"/>
      <geom name="tgt_wall_px" type="box" pos=" 0.11 0 0" size="0.006 0.11 0.06" material="tgt_box_mat"
            friction="1.0 0.005 0.0001"/>
      <geom name="tgt_wall_nx" type="box" pos="-0.11 0 0" size="0.006 0.11 0.06" material="tgt_box_mat"
            friction="1.0 0.005 0.0001"/>
      <geom name="tgt_wall_py" type="box" pos="0  0.11 0" size="0.11 0.006 0.06" material="tgt_box_mat"
            friction="1.0 0.005 0.0001"/>
      <geom name="tgt_wall_ny" type="box" pos="0 -0.11 0" size="0.11 0.006 0.06" material="tgt_box_mat"
            friction="1.0 0.005 0.0001"/>
      <!-- success site: interior of the target box -->
      <site name="tgt_box_inside" pos="0 0 -0.03" size="0.012" rgba="0 1 0 0.5" type="sphere"/>
    </body>
</worldbody>


  <default>
    <geom friction="1.0"/>
  </default>
</mujoco>
