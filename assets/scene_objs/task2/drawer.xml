<mujoco model="g1_43dof tabletop drawer-stow scene">
  <!--
    ============================================================
    T2 — TABLETOP DRAWER STOW  (stationary: pick -> pull small drawer -> stow -> close)
    ============================================================
    ACTIVE task scene (config ROBOT_SCENE points here, original path).
    Redesigned to be a STATIONARY tabletop task (no locomotion):
      - One table in front of the robot at (0.55, 0), top ~0.75 m.
      - A SMALL drawer unit sits ON the table (back-center); its drawer
        opens toward the robot (-X), short travel, with a grab handle.
      - 3 small YCB objects sit on the front of the table, within reach.
    (Earlier floor-cabinet + walking version is archived under tasks/;
     the two-table setting is archived under tasks/T1_twotables/.)

    Layout (robot spawns at origin (0,0,0.78), facing +X):
      - Table (wood)      center (0.55, 0), top 0.75 m, 0.64 x 0.90 m
      - Small drawer unit center (0.70, 0), sits on the table
                          outer ~0.22(X) x 0.24(Y) x 0.13(Z) m
                          drawer opens toward -X (the robot), travel 0..0.12 m
                          interior cavity ~0.18(X) x 0.20(Y) x 0.09(Z) m
      - 3 objects on the front row (x~0.40), within arm reach

    Phases (all reachable standing in place):
      1. pick one of the 3 objects
      2. grasp the drawer handle, pull the small drawer open (slide, -X)
      3. place the object inside the drawer cavity
      4. push the drawer closed

    Success (see tasks/T2_drawer_stow/check_drawer_success.py):
      - object inside the drawer cavity (near site "drawer_inside")
      - drawer opened (slide qpos) > OPEN_THRESHOLD
      - robot base not fallen

    YCB objects (google_16k, must exist under meshes/ycb/) — small & graspable:
      025_mug         ~8 cm, handle -> easy grasp
      011_banana      ~19 cm long, flat
      061_foam_brick  ~5x7.5x5 cm box
    All covered by install_scripts/download_ycb_objects.sh.
  -->
  <!-- Note that the hand model in g1_29dof_with_hand.xml is not stable for simulation. -->
  <compiler meshdir="/inspire/hdd/global_user/liumengfan-253108110079/wsc-workspace/SONIC_DATA/deployment/gear_sonic/data/robot_model/model_data/g1/meshes" texturedir="/inspire/hdd/global_user/liumengfan-253108110079/wsc-workspace/SONIC_DATA/deployment/gear_sonic/data/robot_model/model_data/g1/meshes"/>

  <statistic center="0.4 0 0.7" extent="3.0"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-130" elevation="-20" offwidth="1280" offheight="960"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>

    <material name="table_wood"   rgba="0.55 0.35 0.20 1"/>
    <material name="cabinet_body" rgba="0.42 0.28 0.16 1"/>
    <material name="drawer_face"  rgba="0.62 0.44 0.26 1"/>
    <material name="handle_mat"   rgba="0.20 0.20 0.22 1"/>

    <!-- YCB assets: small graspable objects -->
    <texture name="mug_tex" type="2d" file="ycb/025_mug/texture_map.png"/>
    <material name="mug_mat" texture="mug_tex" specular="0.2" shininess="0.3"/>
    <mesh name="mug_mesh" file="ycb/025_mug/textured.obj"/>

    <texture name="banana_tex" type="2d" file="ycb/011_banana/texture_map.png"/>
    <material name="banana_mat" texture="banana_tex" specular="0.2" shininess="0.3"/>
    <mesh name="banana_mesh" file="ycb/011_banana/textured.obj"/>

    <texture name="brick_tex" type="2d" file="ycb/061_foam_brick/texture_map.png"/>
    <material name="brick_mat" texture="brick_tex" specular="0.2" shininess="0.3"/>
    <mesh name="brick_mesh" file="ycb/061_foam_brick/textured.obj"/>
  </asset>

  <worldbody>
<body name="drawer" pos="0.585 0 0.825">
      <joint name="drawer_slide" type="slide" axis="-1 0 0" ref="0.10" range="0 0.12"
             damping="4" frictionloss="1.5" stiffness="0" limited="true"/>
      <inertial pos="0 0 0" mass="0.4" diaginertia="4e-3 4e-3 4e-3"/>

      <!-- tray: floor + back + 2 sides + interior front wall (cavity 0.18 x 0.20 x 0.09 m) -->
      <geom name="drawer_floor" type="box" pos="0 0 -0.05"   size="0.09 0.10 0.004" material="drawer_face"
            friction="1.0 0.005 0.0001"/>
      <geom name="drawer_back"  type="box" pos="0.094 0 0"   size="0.004 0.10 0.045" material="drawer_face"
            friction="1.0 0.005 0.0001"/>
      <geom name="drawer_left"  type="box" pos="0 0.104 0"   size="0.09 0.004 0.045" material="drawer_face"
            friction="1.0 0.005 0.0001"/>
      <geom name="drawer_right" type="box" pos="0 -0.104 0"  size="0.09 0.004 0.045" material="drawer_face"
            friction="1.0 0.005 0.0001"/>
      <geom name="drawer_front_inner" type="box" pos="-0.094 0 0" size="0.004 0.10 0.045" material="drawer_face"
            friction="1.0 0.005 0.0001"/>
      <!-- decorative front face panel (covers the slot), flush at world x=0.585 when closed -->
      <geom name="drawer_facepanel" type="box" pos="-0.095 0 0" size="0.005 0.11 0.06" material="drawer_face"
            friction="1.0 0.005 0.0001"/>
      <!-- handle bar: thin box protruding toward the robot (-X), graspable -->
      <geom name="drawer_handle" type="box" pos="-0.115 0 0" size="0.008 0.05 0.012" material="handle_mat"
            friction="2.0 0.05 0.001"/>

      <!-- success site: center of the drawer cavity (moves with the drawer) -->
      <site name="drawer_inside" pos="0 0 -0.005" size="0.008" rgba="0 1 0 0.4" type="sphere"/>
      <site name="drawer_handle_site" pos="-0.128 0 0" size="0.006" rgba="1 0.5 0 0.5" type="sphere"/>
    </body>
</worldbody>


  <default>
    <geom friction="1.0"/>
  </default>
</mujoco>
