# Local VLM weight view (symlinks only; weights stay in the HF cache)
groot_repro/nvidia/*-weights/

# Converted G1 task recordings (activedataset ft318: 318 episodes, ≈700 MB). Rebuild with
# scripts/prepare_g1_tasks_npz.py; the source dataset is not part of this repo.
data/npz/g1_tasks*/

# Local training artifacts / checkpoints / datasets (rebuildable; never commit)
runs/
logs/
.sii/
data/library/
data/assets/
*.pt
*.npz

# Orphan URDF hand meshes (~61 MB) that none of the MJCFs reference; the 109 trackable
# G1 meshes are already committed. Blanket-ignore new STLs so the tree stays clean.
reproduce_scenes/g1/meshes/*.STL
reproduce_scenes/g1/meshes/*.stl

# Python deps vendored for the GR00T runner (1.5 GB, reinstallable)
third_party/gr00t_deps/

# G1/YCB mesh assets: kept on disk for MuJoCo, never tracked (fetch separately)
reproduce_scenes/g1/meshes/
GR00T-WholeBodyControl/gear_sonic_deploy/g1/meshes

# Ablation scratch outputs
ablation_fm_grad/results/_isolate/

