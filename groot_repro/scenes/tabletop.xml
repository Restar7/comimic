<mujoco model="g1 tabletop">
  <!-- Minimal tabletop scene: G1 at the origin facing +X, wooden table 0.6 m
       ahead, a carton and a tray on it.  The deployment's own scene XMLs and
       YCB meshes in SONIC_DATA/deployment/scenes were truncated to 0 bytes, so
       the props are rebuilt from primitives with the same layout. -->
  <include file="g1_29dof_with_hand.xml"/>

  <statistic center="0.3 0 0.6" extent="1.5"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-130" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4"
      rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="wood" rgba="0.85 0.55 0.25 1"/>
    <material name="carton_mat" rgba="0.75 0.75 0.72 1"/>
    <material name="tray_mat" rgba="0.35 0.4 0.45 1"/>
  </asset>

  <worldbody>
    <light pos="0.5 0 1.8" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- table: top at 0.72 m -->
    <body name="table" pos="0.62 0 0.36">
      <geom type="box" size="0.30 0.45 0.02" pos="0 0 0.36" material="wood" contype="1" conaffinity="1"/>
      <geom type="box" size="0.025 0.025 0.18" pos="0.26 0.40 0.18" material="wood"/>
      <geom type="box" size="0.025 0.025 0.18" pos="0.26 -0.40 0.18" material="wood"/>
      <geom type="box" size="0.025 0.025 0.18" pos="-0.26 0.40 0.18" material="wood"/>
      <geom type="box" size="0.025 0.025 0.18" pos="-0.26 -0.40 0.18" material="wood"/>
    </body>

    <!-- carton on the table -->
    <body name="carton" pos="0.55 0.0 0.79">
      <freejoint/>
      <geom type="box" size="0.045 0.035 0.055" material="carton_mat" mass="0.2"/>
    </body>

    <!-- tray -->
    <body name="tray" pos="0.68 0.26 0.745">
      <freejoint/>
      <geom type="box" size="0.14 0.10 0.012" material="tray_mat" mass="0.3"/>
    </body>
  </worldbody>
</mujoco>
