<mujoco model="g1_twotables scene">
  <!--
    ============================================================
    TWO-TABLE CARRY TASK (walk → pick → turn → walk → place)
    ============================================================
    Layout:
      - G1 spawns at world origin (0, 0, 0.78), facing +X
      - Table A (source)  at ( 1.5, 0):  candidate objects on near edge
      - Table B (target)  at (-1.5, 0):  open box on near edge
    Task:
      1. walk ~1.2m forward to Table A
      2. pick the target object (tall bottle — easy to grasp)
      3. turn 180°
      4. walk ~2.6m to Table B
      5. place object into the open box

    PREVIEW MODE: currently 3 tall-object candidates + apple (size ref)
    are all on Table A. After choosing one, remove the others or keep
    them as distractors for language grounding.

    Candidates (YCB google_16k):
      006_mustard_bottle   ~6.5×9.5cm cross, 19.5cm tall
      021_bleach_cleanser  ~6×10cm cross,   25cm tall
      004_sugar_box        4.4×9cm cross,   17.5cm tall
      013_apple            7.5cm dia (size reference)

    Download meshes:  bash install_scripts/download_ycb_objects.sh
    (script must include the new object IDs)
  -->

  <include file="g1_29dof_with_hand.xml"/>
  <compiler texturedir="meshes"/>

  <statistic center="0 0 0.7" extent="5.0"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-130" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>

    <material name="table_wood"  rgba="0.55 0.35 0.20 1"/>
    <material name="table_white" rgba="0.85 0.85 0.82 1"/>
    <material name="box_gray"    rgba="0.65 0.65 0.65 1"/>

    <!-- YCB assets -->
    <texture name="mustard_tex" type="2d" file="ycb/006_mustard_bottle/texture_map.png"/>
    <material name="mustard_mat" texture="mustard_tex" specular="0.2" shininess="0.3"/>
    <mesh name="mustard_mesh" file="ycb/006_mustard_bottle/textured.obj"/>

    <texture name="bleach_tex" type="2d" file="ycb/021_bleach_cleanser/texture_map.png"/>
    <material name="bleach_mat" texture="bleach_tex" specular="0.2" shininess="0.3"/>
    <mesh name="bleach_mesh" file="ycb/021_bleach_cleanser/textured.obj"/>

    <texture name="sugar_tex" type="2d" file="ycb/004_sugar_box/texture_map.png"/>
    <material name="sugar_mat" texture="sugar_tex" specular="0.2" shininess="0.3"/>
    <mesh name="sugar_mesh" file="ycb/004_sugar_box/textured.obj"/>

    <texture name="apple_tex" type="2d" file="ycb/013_apple/texture_map.png"/>
    <material name="apple_mat" texture="apple_tex" specular="0.2" shininess="0.3"/>
    <mesh name="apple_mesh" file="ycb/013_apple/textured.obj"/>
  </asset>

  <worldbody>
    <!-- Lighting -->
    <light pos="0 0 3" dir="0 0 -1" directional="true" diffuse="0.8 0.8 0.8"/>
    <light pos="1.5 0 2.5" dir="0 0 -1" diffuse="0.35 0.35 0.35"/>
    <light pos="-1.5 0 2.5" dir="0 0 -1" diffuse="0.35 0.35 0.35"/>

    <!-- Ground -->
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- ================================================================ -->
    <!-- TABLE A (source, wood) — center (1.5, 0), top 0.85m, 70×110cm     -->
    <!-- X span: 1.15 → 1.85 (near edge at 1.15 facing robot)              -->
    <!-- ================================================================ -->
    <body name="table_A" pos="1.5 0 0.415">
      <geom name="tableA_top" type="box" pos="0 0 0.415" size="0.35 0.55 0.02"
            material="table_wood" friction="1.0 0.005 0.0001"/>
      <geom name="tableA_leg_1" type="cylinder" pos=" 0.32  0.52 0" size="0.025 0.415" material="table_wood"/>
      <geom name="tableA_leg_2" type="cylinder" pos="-0.32  0.52 0" size="0.025 0.415" material="table_wood"/>
      <geom name="tableA_leg_3" type="cylinder" pos=" 0.32 -0.52 0" size="0.025 0.415" material="table_wood"/>
      <geom name="tableA_leg_4" type="cylinder" pos="-0.32 -0.52 0" size="0.025 0.415" material="table_wood"/>
    </body>

    <!-- ================================================================ -->
    <!-- TABLE B (target, white) — center (-1.5, 0), top 0.85m, 70×110cm   -->
    <!-- X span: -1.15 → -1.85 (near edge at -1.15 facing robot)           -->
    <!-- ================================================================ -->
    <body name="table_B" pos="-1.5 0 0.415">
      <geom name="tableB_top" type="box" pos="0 0 0.415" size="0.35 0.55 0.02"
            material="table_white" friction="1.0 0.005 0.0001"/>
      <geom name="tableB_leg_1" type="cylinder" pos=" 0.32  0.52 0" size="0.025 0.415" material="table_white"/>
      <geom name="tableB_leg_2" type="cylinder" pos="-0.32  0.52 0" size="0.025 0.415" material="table_white"/>
      <geom name="tableB_leg_3" type="cylinder" pos=" 0.32 -0.52 0" size="0.025 0.415" material="table_white"/>
      <geom name="tableB_leg_4" type="cylinder" pos="-0.32 -0.52 0" size="0.025 0.415" material="table_white"/>
    </body>

    <!-- ================================================================ -->
    <!-- CANDIDATE OBJECTS on Table A near edge (x=1.32), spread along Y   -->
    <!-- Spawn a bit above table; physics settles them on reset            -->
    <!-- ================================================================ -->
    <body name="apple" pos="1.22 -0.30 0.90">
      <freejoint name="apple_freejoint"/>
      <inertial pos="0 0 0" mass="0.068" diaginertia="4.4e-5 4.4e-5 4.4e-5"/>
      <geom name="apple_geom" type="mesh" mesh="apple_mesh" material="apple_mat"
            friction="2.0 0.05 0.001" solref="0.005 1" solimp="0.9 0.95 0.001"/>
    </body>

    <body name="mustard_bottle" pos="1.22 -0.10 0.96">
      <freejoint name="mustard_freejoint"/>
      <inertial pos="0 0 0" mass="0.19" diaginertia="6.0e-4 6.0e-4 1.2e-4"/>
      <geom name="mustard_geom" type="mesh" mesh="mustard_mesh" material="mustard_mat"
            friction="2.0 0.05 0.001" solref="0.005 1" solimp="0.9 0.95 0.001"/>
    </body>

    <body name="bleach_cleanser" pos="1.22 0.10 0.98">
      <freejoint name="bleach_freejoint"/>
      <inertial pos="0 0 0" mass="0.30" diaginertia="1.4e-3 1.4e-3 2.0e-4"/>
      <geom name="bleach_geom" type="mesh" mesh="bleach_mesh" material="bleach_mat"
            friction="2.0 0.05 0.001" solref="0.005 1" solimp="0.9 0.95 0.001"/>
    </body>

    <body name="sugar_box" pos="1.22 0.30 0.95">
      <freejoint name="sugar_freejoint"/>
      <inertial pos="0 0 0" mass="0.17" diaginertia="5.0e-4 4.0e-4 1.5e-4"/>
      <geom name="sugar_geom" type="mesh" mesh="sugar_mesh" material="sugar_mat"
            friction="2.0 0.05 0.001" solref="0.005 1" solimp="0.9 0.95 0.001"/>
    </body>

    <!-- ================================================================ -->
    <!-- OPEN BOX on Table B near edge — interior 24×24×15cm               -->
    <!-- ================================================================ -->
    <body name="box" pos="-1.22 0 0.85">
      <geom name="box_floor"      type="box" pos="0 0 0.008"      size="0.13 0.13 0.008" material="box_gray"/>
      <geom name="box_wall_north" type="box" pos=" 0.123 0 0.083" size="0.008 0.13 0.075" material="box_gray"/>
      <geom name="box_wall_south" type="box" pos="-0.123 0 0.083" size="0.008 0.13 0.075" material="box_gray"/>
      <geom name="box_wall_east"  type="box" pos=" 0  0.123 0.083" size="0.13 0.008 0.075" material="box_gray"/>
      <geom name="box_wall_west"  type="box" pos=" 0 -0.123 0.083" size="0.13 0.008 0.075" material="box_gray"/>
    </body>

    <!-- Sites for success detection -->
    <site name="tableA_center" pos="1.50 0 0.85"  size="0.005" rgba="1 1 0 0.3"/>
    <site name="tableB_center" pos="-1.50 0 0.85" size="0.005" rgba="1 1 0 0.3"/>
    <site name="box_center"    pos="-1.22 0 0.93" size="0.005" rgba="0.5 0.5 0.5 0.3"/>

    <!-- Cameras -->
    <camera name="ego_view"  mode="fixed" pos="0 0 1.65" euler="1.4 0 -1.5708" fovy="90"/>
    <camera name="side_view" mode="fixed" pos="0 -3.5 2.0" xyaxes="1 0 0 0 0.5 0.87" fovy="90"/>
    <camera name="top_down"  mode="fixed" pos="0 0 4.5" euler="0 0 0" fovy="90"/>
    <camera name="tableA_view" mode="fixed" pos="2.8 -1.2 1.6" xyaxes="-0.4 -0.9 0 0.3 -0.15 0.94" fovy="55"/>
  </worldbody>

  <default>
    <geom friction="2.0 0.05 0.001"/>
  </default>
</mujoco>
