<mujoco model="g1_43dof floor-to-table-lift scene">
  <!--
    ============================================================
    T3 — FLOOR-TO-TABLE LIFT  (stationary: deep sagittal trunk bend)
    ============================================================
    ACTIVE task scene (config ROBOT_SCENE points here, original path).
    Stationary task, everything in FRONT so the motion stays sagittal (no turning):
      - Object sits on the FLOOR in front of the robot
      - A tall TABLE in front is the placement target (top ~0.87 m)
    Coupling axis: deep trunk flexion in the sagittal plane (bend/squat down, stand up).

    Layout (robot spawns at origin (0,0,0.78), facing +X):
      - Floor object  at (0.70, 0, ~0.05)  -> forward on the floor, inside the head-camera FOV
      - Table (wood)  center (1.00, 0), top 0.87 m, 0.44(X) x 0.90(Y)
                      front edge at x = 0.78 (robot well back from it)

    Phases (stationary):
      1. bend / squat down to the floor object (deep sagittal trunk flexion)
      2. grasp it
      3. stand back up
      4. place it on the table top (z ~ 0.87)

    Success (see tasks/T3_floor_to_table/check_floor_to_table_success.py):
      - object resting ON the table top (z above ~0.87, xy within the table)
      - object stable / static, robot not fallen

    YCB objects (google_16k, must exist under meshes/ycb/):
      005_tomato_soup_can  ~6.6 cm dia x 10 cm, ~349 g -> easy to grasp off the floor
    Covered by install_scripts/download_ycb_objects.sh.
  -->

  <include file="g1_29dof_with_hand.xml"/>
  <!-- Note that the hand model in g1_29dof_with_hand.xml is not stable for simulation. -->
  <compiler texturedir="meshes"/>

  <statistic center="0.4 0 0.5" extent="3.0"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-130" elevation="-20" offwidth="1280" offheight="960"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>

    <material name="table_wood" rgba="0.55 0.35 0.20 1"/>

    <!-- YCB object -->
    <texture name="can_tex" type="2d" file="ycb/005_tomato_soup_can/texture_map.png"/>
    <material name="can_mat" texture="can_tex" specular="0.2" shininess="0.3"/>
    <mesh name="can_mesh" file="ycb/005_tomato_soup_can/textured.obj"/>
  </asset>

  <worldbody>
    <!-- Lighting -->
    <light pos="0 0 3" dir="0 0 -1" directional="true" diffuse="0.8 0.8 0.8"/>
    <light pos="0.6 0 2.5" dir="0 0 -1" diffuse="0.4 0.4 0.4"/>

    <!-- Ground -->
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- ================================================================ -->
    <!-- TABLE (wood) — center (0.85, 0), TALL top 0.87 m, 0.44(X) x 0.90(Y) -->
    <!-- front edge (near robot) at x = 0.63                                -->
    <!-- ================================================================ -->
    <body name="table_A" pos="1.00 0 0.425">
      <geom name="tableA_top" type="box" pos="0 0 0.425" size="0.22 0.45 0.02"
            material="table_wood" friction="1.0 0.005 0.0001"/>
      <geom name="tableA_leg_1" type="cylinder" pos=" 0.19  0.42 0" size="0.025 0.425" material="table_wood"/>
      <geom name="tableA_leg_2" type="cylinder" pos="-0.19  0.42 0" size="0.025 0.425" material="table_wood"/>
      <geom name="tableA_leg_3" type="cylinder" pos=" 0.19 -0.42 0" size="0.025 0.425" material="table_wood"/>
      <geom name="tableA_leg_4" type="cylinder" pos="-0.19 -0.42 0" size="0.025 0.425" material="table_wood"/>
    </body>

    <!-- ================================================================ -->
    <!-- RAISED PICK OBJECT — 005_tomato_soup_can on a fixed solid platform -->
    <!-- original x/y retained at (0.70, 0); only height is raised         -->
    <!-- friction raised to 2.0 for a stable grasp                        -->
    <!-- ================================================================ -->
    <!-- Fixed solid pick platform: height 0.435 m = 1/2 of the 0.87 m table -->
    <body name="pick_platform" pos="0.70 0 0.2175">
      <geom name="pick_platform_geom" type="box" pos="0 0 0" size="0.15 0.15 0.2175"
            material="table_wood" friction="1.5 0.01 0.001"/>
    </body>
    <body name="tomato_soup_can" pos="0.59466 0 0.48665">
      <freejoint name="can_freejoint"/>
      <inertial pos="0 0 0" mass="0.349" diaginertia="4.0e-4 4.0e-4 2.0e-4"/>
      <!-- Convex collision proxy keeps the visual YCB mesh stable on box surfaces -->
      <geom name="can_collision" type="cylinder" pos="-0.0001637 -0.0000444 -0.0007469" size="0.0345 0.050903"
            rgba="0 0 0 0" friction="2.0 0.05 0.001" solref="0.005 1" solimp="0.9 0.95 0.001"/>
      <geom name="can_geom" type="mesh" mesh="can_mesh" material="can_mat"
            pos="-0.0845080153 -0.0066493937 -0.0516600436"
            quat="0.6955552576 -0.0008874447 -0.0002679897 -0.7184720065"
            contype="0" conaffinity="0"
            friction="2.0 0.05 0.001" solref="0.005 1" solimp="0.9 0.95 0.001"/>
    </body>

    <!-- Reference sites -->
    <site name="floor_pick"    pos="0.59466 0 0.465" size="0.01" rgba="1 0.6 0 0.4" type="sphere"/>
    <site name="table_target"  pos="0.85 0 0.90" size="0.012" rgba="0 1 0 0.5" type="sphere"/>

    <!-- Cameras -->
    <camera name="ego_view"   mode="fixed" pos="0 0 1.65" euler="1.4 0 -1.5708" fovy="90"/>
    <camera name="side_view"  mode="fixed" pos="0.45 -2.4 0.9" xyaxes="1 0 0 0 0.35 0.94" fovy="55"/>
    <camera name="top_down"   mode="fixed" pos="0.45 0 2.4" euler="0 0 0" fovy="60"/>
    <camera name="q3_view"    mode="fixed" pos="-0.8 -1.4 1.3" xyaxes="0.86 -0.51 0 0.20 0.34 0.92" fovy="55"/>
  </worldbody>

  <default>
    <geom friction="1.0"/>
  </default>
</mujoco>
